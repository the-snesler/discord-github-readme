{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "jsx": "react",
    "allowJs": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "frontend", "public", "dist"]
}
